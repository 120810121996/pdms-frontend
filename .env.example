PORT=3000
JWT_SECRET=pdms_super_secret_key_change_in_production_2024
JWT_EXPIRES_IN=7d

# Email Configuration SMTP (mettre SMTP_ENABLED=true et configurer ci-dessous)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre_email@gmail.com
SMTP_PASS=votre_mot_de_passe_app
SMTP_FROM=PDMS App <votre_email@gmail.com>

# Compte Admin par defaut (cree au premier demarrage)
ADMIN_EMAIL=admin@pdms.com
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=Administrateur

# Base de donnees de secours PostgreSQL
POSTGRES_BACKUP_ENABLED=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pdms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SYNC_INTERVAL_MINUTES=15

